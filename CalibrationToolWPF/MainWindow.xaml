<Window x:Class="CalibrationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="CalibrationTool" 
        Height="800" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundGrayBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <!-- 输入框占位符样式 -->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <!-- 根Grid包含DialogHost和Toast容器 -->
    <Grid>
        <!-- DialogHost 包装整个内容 -->
        <materialDesign:DialogHost Identifier="RootDialog" 
                                   DialogTheme="Inherit"
                                   CloseOnClickAway="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 主内容区域 -->
            <TabControl Grid.Row="0" 
                    Style="{StaticResource MaterialDesignFilledTabControl}"
                    Margin="16,16,16,8"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                <!-- 多项式拟合标签页 -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="多项式拟合" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Background="{StaticResource BackgroundGrayBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                            <ColumnDefinition Width="1.3*" MinWidth="450"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：数据输入区域 -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource CardTitleStyle}">
                                <materialDesign:PackIcon Kind="TableEdit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                数据输入
                                </TextBlock>

                                <!-- 数据表格区域 -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ADC值表格 -->
                                    <Border Grid.Column="0" Margin="0,0,4,0" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#FAFAFA" Padding="8" CornerRadius="4,4,0,0">
                                                <TextBlock Text="📥 ADC原始值" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                            <DataGrid Grid.Row="1" x:Name="dgAdc" 
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  HeadersVisibility="None"
                                                  Style="{StaticResource ModernDataGridStyle}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ADC值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <!-- 真实值表格 -->
                                    <Border Grid.Column="1" Margin="4,0,0,0" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#FAFAFA" Padding="8" CornerRadius="4,4,0,0">
                                                <TextBlock Text="📤 真实值" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                            <DataGrid Grid.Row="1" x:Name="dgReal" 
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  HeadersVisibility="None"
                                                  Style="{StaticResource ModernDataGridStyle}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="真实值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                        <DataGridTextColumn.EditingElementStyle>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                            </Style>
                                                        </DataGridTextColumn.EditingElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 控制按钮区域 -->
                                <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="多项式阶数:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="cbDegree" Width="70" SelectedIndex="2"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="阶数">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                        </ComboBox>

                                        <Button x:Name="btnFit" Content="拟合" Margin="16,0,0,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="4"
                                            Click="BtnFit_Click">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ChartBellCurve" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="拟合"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button x:Name="btnClear" Content="清空" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="4"
                                            Click="BtnClear_Click">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="清空"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>

                                        <Button x:Name="btnCopy" Content="复制公式" Margin="8,0,0,0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="4"
                                            Click="BtnCopy_Click">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="复制"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 拟合结果显示 -->
                                <Border Grid.Row="3" Background="#F6FFED" BorderBrush="#B7EB8F" BorderThickness="1" 
                                    CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Function" Grid.Column="0" 
                                                             VerticalAlignment="Center" Margin="0,0,8,0"
                                                             Foreground="{StaticResource SuccessGreenBrush}"/>
                                        <TextBox x:Name="txtResult" Grid.Column="1" 
                                             IsReadOnly="True" 
                                             Background="Transparent" 
                                             BorderThickness="0"
                                             Text="拟合结果将显示在这里..."
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- 单点验证区域 -->
                                <Border Grid.Row="4" Background="#FAFAFA" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="🔬 单点验证" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="txtSingleAdc" Grid.Column="0" Margin="0,0,8,0"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="输入ADC值"
                                                 materialDesign:HintAssist.IsFloating="True"/>

                                            <TextBox x:Name="txtSingleReal" Grid.Column="1" Margin="0,0,8,0"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="真实值(可选)"
                                                 materialDesign:HintAssist.IsFloating="True"/>

                                            <Button x:Name="btnCalcSingle" Grid.Column="2"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                Click="BtnCalcSingle_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Calculator" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="计算"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <TextBox x:Name="txtSingleResult" Grid.Row="2" Margin="0,8,0,0"
                                             IsReadOnly="True" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="计算结果"
                                             TextWrapping="Wrap"
                                             MinHeight="60"
                                             AcceptsReturn="True"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 右侧：验证结果区域 -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource CardTitleStyle}">
                                <materialDesign:PackIcon Kind="CheckDecagram" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                验证结果
                                </TextBlock>

                                <DataGrid Grid.Row="1" x:Name="dgVerify"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Style="{StaticResource ModernDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ADC值" Binding="{Binding Adc}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="预测值" Binding="{Binding Predicted}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="实际值" Binding="{Binding Actual}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="误差(%)" Binding="{Binding Error}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="{Binding ErrorBrush}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 串口下载标签页 -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SerialPort" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="串口下载" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Background="{StaticResource BackgroundGrayBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：串口设置 -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}">
                                <materialDesign:PackIcon Kind="Cog" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                串口设置
                                </TextBlock>

                                <!-- 端口选择 -->
                                <TextBlock Text="串口端口" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbPort" Grid.Column="0"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="选择串口"/>
                                    <Button x:Name="btnRefresh" Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="刷新串口"
                                        Click="BtnRefresh_Click">
                                        <materialDesign:PackIcon Kind="Refresh"/>
                                    </Button>
                                </Grid>

                                <!-- 波特率选择 -->
                                <TextBlock Text="波特率" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cbBaudRate" Margin="0,0,0,16"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="选择波特率"
                                      SelectedIndex="4">
                                    <ComboBoxItem Content="9600"/>
                                    <ComboBoxItem Content="19200"/>
                                    <ComboBoxItem Content="38400"/>
                                    <ComboBoxItem Content="57600"/>
                                    <ComboBoxItem Content="115200"/>
                                    <ComboBoxItem Content="230400"/>
                                    <ComboBoxItem Content="460800"/>
                                    <ComboBoxItem Content="921600"/>
                                </ComboBox>

                                <!-- 连接按钮和状态 -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnConnect" Grid.Column="0"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="4"
                                        Width="120"
                                        Click="BtnConnect_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon x:Name="iconConnect" Kind="Connection" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="txtConnect" Text="连接"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Ellipse x:Name="statusIndicator" Width="10" Height="10" Fill="{StaticResource ErrorRedBrush}"/>
                                        <TextBlock x:Name="txtConnStatus" Text="未连接" Margin="8,0,0,0" Foreground="{StaticResource ErrorRedBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,0,0,20"/>

                                <!-- 通道选择 -->
                                <TextBlock Text="目标通道" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbChannel" Grid.Column="0"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="选择通道"/>
                                    <Button x:Name="btnReadChannels" Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="4"
                                        IsEnabled="False"
                                        Click="BtnReadChannels_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BookOpen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="回读"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 公式输入 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="多项式公式" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Button x:Name="btnUseFormula" Grid.Column="1"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="8,2"
                                        Height="24"
                                        Click="BtnUseFormula_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentPaste" VerticalAlignment="Center" Margin="0,0,4,0" Width="14" Height="14"/>
                                            <TextBlock Text="使用拟合结果" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="txtFormula" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="y = a*x^3 + b*x^2 + c*x + d"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"
                                     Margin="0,0,0,16"/>

                                <!-- 操作按钮 -->
                                <Button x:Name="btnSendFormula" 
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    Height="44"
                                    FontSize="14"
                                    IsEnabled="False"
                                    Click="BtnSendFormula_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Upload" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                                        <TextBlock Text="发送到设备"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnReadCoeffs" Margin="0,8,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    Height="36"
                                    IsEnabled="False"
                                    Click="BtnReadCoeffs_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Download" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="读取设备系数"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：通信日志 -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource CardTitleStyle}">
                                    <materialDesign:PackIcon Kind="Console" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    通信日志
                                    </TextBlock>
                                    
                                    <!-- 编码选择 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="编码:" VerticalAlignment="Center" Margin="0,0,4,0" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <ComboBox x:Name="cbEncoding" Width="85" Height="28"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              SelectedIndex="0"
                                              FontSize="12"
                                              Padding="8,2"
                                              materialDesign:HintAssist.Hint="编码"
                                              SelectionChanged="CbEncoding_SelectionChanged">
                                            <ComboBoxItem Content="UTF-8"/>
                                            <ComboBoxItem Content="GB2312"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <Button x:Name="btnClearLog" Grid.Column="2"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Click="BtnClearLog_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="清空"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4">
                                    <TextBox x:Name="txtLog" 
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="Transparent"
                                         Foreground="#D4D4D4"
                                         BorderThickness="0"
                                         Padding="12"
                                         FontFamily="Consolas"
                                         FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 使用帮助标签页 -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HelpCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="使用帮助" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer Background="{StaticResource BackgroundGrayBrush}" Padding="8">
                        <StackPanel>
                            <!-- 多项式拟合功能 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}">
                                    <materialDesign:PackIcon Kind="ChartLine" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                    多项式拟合功能
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource TextSecondaryBrush}">
                                    1. 在左侧表格中输入ADC原始值和对应的真实值
                                    <LineBreak/>
                                    2. 设置多项式阶数 (建议3-4阶)
                                    <LineBreak/>
                                    3. 点击 [拟合] 生成校准公式
                                    <LineBreak/>
                                    4. 查看右侧验证结果，确认误差在可接受范围内
                                    <LineBreak/>
                                    5. 可使用单点计算功能验证任意ADC值
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 串口下载功能 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}">
                                    <materialDesign:PackIcon Kind="SerialPort" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource SuccessGreenBrush}"/>
                                    串口下载功能
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource TextSecondaryBrush}">
                                    1. 选择正确的串口和波特率
                                    <LineBreak/>
                                    2. 点击 [连接] 建立通信
                                    <LineBreak/>
                                    3. 点击 [回读] 获取设备通道列表
                                    <LineBreak/>
                                    4. 选择目标通道
                                    <LineBreak/>
                                    5. 输入公式或点击 [使用拟合结果]
                                    <LineBreak/>
                                    6. 点击 [发送到设备] 完成下载
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 公式格式 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}">
                                    <materialDesign:PackIcon Kind="Function" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource WarningOrangeBrush}"/>
                                    公式格式说明
                                    </TextBlock>
                                    <Border Background="#FFF7E6" CornerRadius="4" Padding="12">
                                        <TextBlock FontFamily="Consolas" FontSize="13">
                                        y = 8.03e-9*x^3 + -3.58e-5*x^2 + 1.575*x + -18.58
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                    • 支持科学计数法 (如: 1.23e-5)
                                    <LineBreak/>
                                    • 系数和变量之间使用 * 连接
                                    <LineBreak/>
                                    • 幂次使用 ^ 表示
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 注意事项 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}">
                                    <materialDesign:PackIcon Kind="AlertCircle" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource ErrorRedBrush}"/>
                                    注意事项
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource TextSecondaryBrush}">
                                    • 确保ADC值和真实值数量相同
                                    <LineBreak/>
                                    • 多项式阶数不宜过高，避免过拟合
                                    <LineBreak/>
                                    • 建议在下载前先验证拟合结果
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 底部状态栏 -->
            <Border Grid.Row="1" Background="White" Padding="16,8" Margin="16,0,16,16" CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="statusIcon" Kind="CheckCircle" 
                                             Foreground="{StaticResource SuccessGreenBrush}" 
                                             VerticalAlignment="Center" 
                                             Width="18" Height="18"/>
                        <TextBlock x:Name="txtStatus" Text="就绪" Margin="8,0,0,0" 
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessGreenBrush}"/>
                    </StackPanel>

                    <TextBlock Text="© 2025 胡兴明. All Rights Reserved." 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="895,0,15,0"/>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
    
    <!-- Toast 消息容器 - 位于最顶层 -->
    <ItemsControl x:Name="ToastContainer" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Top"
                  Margin="0,24,0,0"
                  Panel.ZIndex="9999">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</Grid>
</Window>
